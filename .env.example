TELEGRAM_BOT_TOKEN=
# Default recipients, used by monitors that don't set their own chatIds in config.js
TELEGRAM_CHAT_IDS=
CHECK_INTERVAL_MS=300000

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false

# --- Монеты (coins.js, load-catalog.js) ---
# «Выгодно»: разница с ориентиром >= COINS_BARGAIN_BYN рублей, либо лот ниже ориентира на COINS_BARGAIN_PCT %
# и разница при этом >= COINS_BARGAIN_MIN_BYN рублей
COINS_BARGAIN_BYN=50
COINS_BARGAIN_PCT=30
COINS_BARGAIN_MIN_BYN=10
# Поправка к ценам внешних аукционов (gdenashel.ru, RUB → BYN) под наш рынок: 0.8 = считать, что у нас на 20% дешевле
COINS_CATALOG_FACTOR=1
# Окно проходов для каталога, лет (load-catalog.js)
COINS_CATALOG_YEARS=3
# За сколько минут до конца аукциона перечитывать ставку и сохранять фото (после окончания страница лота отдаёт 404)
COINS_PRECLOSE_MIN=40
# Фото лотов: папка, общий лимит в МБ (лишнее удаляется, проданные — последними), снимков на лот.
# Снимки сжимаются (sharp, ставится с npm install) до COINS_PHOTO_WIDTH px / качество COINS_PHOTO_QUALITY
COINS_PHOTO_DIR=./coin-photos
COINS_PHOTO_MAX_MB=1024
COINS_PHOTO_PER_LOT=2
COINS_PHOTO_WIDTH=450
COINS_PHOTO_QUALITY=75
# ay.by: таймаут загрузки страницы и число подряд таймаутов/403/429, после которого цикл прерывается
COINS_NAV_TIMEOUT_MS=30000
COINS_MAX_STRIKES=3
# Numista (необязательно; бесплатный ключ: numista.com → API). Без ключа каталог только из load-catalog.js
NUMISTA_API_KEY=
# Цена металла (BYN за грамм) на случай, если API слитков НБРБ недоступен; обычно берётся с api.nbrb.by/ingots/prices
COINS_GOLD_BYN_PER_G=
COINS_SILVER_BYN_PER_G=
# ay.by: аккаунт для избранного и снайп-ставок. Проще всего войти руками: node ayby-login.js (окно браузера на сервере),
# cookies сохранятся в AYBY_SESSION_FILE (по умолчанию ./ayby-session.json), пароль в .env не нужен.
# AYBY_LOGIN/AYBY_PASSWORD — необязательный запасной вариант: автоматический вход, когда сессия протухла.
# Проверка сессии: node ayby-login.js --check
AYBY_LOGIN=
AYBY_PASSWORD=
AYBY_SESSION_FILE=
# Снайп-ставки (sniper.js, pm2: coins-sniper): ответ на карточку лота числом = максимальная ставка.
# Ник на ay.by — чтобы бот узнавал вас в «победитель …» после торгов; ayby-login.js сам записывает его в файл сессии,
# задавать нужно только если там пусто. Чаты, которым разрешено ставить (по умолчанию TELEGRAM_CHAT_IDS).
# За сколько секунд до конца подтверждать ставку. AYBY_CDP=9222 — только для локальной отладки: работать через
# обычный Chrome, запущенный с --remote-debugging-port (он проходит проверку ay.by на бота, headless с ноутбука — нет).
AYBY_NICK=
SNIPE_CHAT_IDS=
SNIPE_SECONDS=30
AYBY_CDP=

# --- Необязательное (значения по умолчанию) ---
# CHECK_INTERVAL_MS=60000           Kufar: период цикла listings.js
# SOLD_CHECK_BATCH=12               Kufar: сколько пропавших объявлений перепроверять за цикл
# COINS_INTERVAL_MS=600000          ay.by: период цикла coins.js
# COINS_PAGES=3                     ay.by: страниц раздела за цикл (COINS_SEED_PAGES=8 при первом запуске)
# COINS_DEEP_PAGES=40               ay.by: страниц глубокого прохода всех разделов за цикл (круг — раз в сутки)
# COINS_AUCTION_NOTIFY_HOURS=12     ay.by: чистые аукционы — уведомлять не раньше чем за N часов до конца
# COINS_QUIET_HOURS=24              ay.by: тихие лоты — проверять за N часов до конца
# COINS_QUIET_MAX_BIDS=1            ay.by: тихий лот — не больше N ставок
# COINS_QUIET_MIN_REF=30            ay.by: тихий лот — ориентир не меньше N р.
# COINS_SLAB_MIN_BYN=60             слабы с ориентиром ниже — не интересны (это цена слабирования)
# COINS_LOW_RATING=20               продавец с рейтингом ниже — предупреждение в карточке
# COINS_USER_LOOKUPS=10             ay.by: профилей победителей торгов читать за цикл (рейтинг для coin-funnel.js)
# COINS_FEED_INTERVAL_MS=90000    ay.by: лента новых лотов coins.ay.by/new/ — как часто (0 — выключить)
# COINS_FEED_PAGES=2                ay.by: страниц ленты за проход (по ~100 лотов)
# COINS_SELLER_MAX_PAGES=15         ay.by: страниц продавца по 100 лотов за цикл (монитор coins-sellers)
# KUFAR_LOTS_MAX_BYN=0              Kufar: коллекции/россыпь присылать до этой цены (0 — при любой)
# COINS_GRADE_DISCOUNT=1            на сколько ступеней ниже смотреть каталоги для состояния со слов продавца (0 — верить)

# Оценка монет по фото в боте (poll.js → coins/vision.js). Без ключа выключена.
ANTHROPIC_API_KEY=
# или через шлюз: адрес шлюза, ключ шлюза — в ANTHROPIC_API_KEY (или ANTHROPIC_AUTH_TOKEN, если шлюз ждёт Bearer);
# запасная модель при отказе через шлюз по умолчанию выключена
# ANTHROPIC_API_URL=https://...
# или OpenAI (если ключа Anthropic нет — берётся он):
# OPENAI_API_KEY=
# COINS_VISION_PROVIDER=              anthropic | openai — выбрать явно, если заданы оба ключа
# COINS_VISION_MODEL=claude-opus-5-5  модель (для OpenAI по умолчанию gpt-5.5)
# COINS_VISION_PRICE=                 цена модели $ за 1M токенов «вход,выход» — для строки расхода в ответе
# COINS_VISION_EFFORT=medium          глубина рассуждения: low | medium | high
# COINS_VISION_FALLBACK=1             0 — не повторять на запасной модели при отказе
# COINS_VISION_CALIBRATE=1           0 — без поправки состояния по сверке с экспертами (VF модели → F, F → VG)
# COINS_CONTENT_LOOKUP=1             вес металла монет без таблицы и без веса в тексте: наша база → Numista → модель (0 — только база)
# COINS_CONTENT_MODEL=claude-sonnet-5-5  модель для вопроса о весе (текстом, ≈ $0,008; ответ кэшируется в coin_catalog)
# COINS_CONTENT_MODEL_PER_DAY=100    не больше N таких вопросов к модели в сутки
# COINS_OFFER_SHARE=0.55             сколько предлагать продавцу: доля ориентира (но не меньше стоимости металла)
# SNIPE_LEAD_MIN=6                  снайпер: за сколько минут до конца брать заявку в работу
# SNIPE_POLL_MS=15000               снайпер: период опроса заявок
