TELEGRAM_BOT_TOKEN=
# Default recipients, used by monitors that don't set their own chatIds in config.js
TELEGRAM_CHAT_IDS=
CHECK_INTERVAL_MS=300000

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false

# --- Монеты (coins.js, load-catalog.js) ---
# «Выгодно»: разница с ориентиром >= COINS_BARGAIN_BYN рублей, либо лот ниже ориентира на COINS_BARGAIN_PCT %
# и разница при этом >= COINS_BARGAIN_MIN_BYN рублей
COINS_BARGAIN_BYN=50
COINS_BARGAIN_PCT=30
COINS_BARGAIN_MIN_BYN=10
# Поправка к ценам внешних аукционов (gdenashel.ru, RUB → BYN) под наш рынок: 0.8 = считать, что у нас на 20% дешевле
COINS_CATALOG_FACTOR=1
# Окно проходов для каталога, лет (load-catalog.js)
COINS_CATALOG_YEARS=3
# За сколько минут до конца аукциона перечитывать ставку и сохранять фото (после окончания страница лота отдаёт 404)
COINS_PRECLOSE_MIN=40
# Фото лотов: папка, общий лимит в МБ (лишнее удаляется, проданные — последними), снимков на лот.
# Если установлен пакет sharp (npm i sharp), снимки сжимаются до COINS_PHOTO_WIDTH px / качество COINS_PHOTO_QUALITY
COINS_PHOTO_DIR=./coin-photos
COINS_PHOTO_MAX_MB=1024
COINS_PHOTO_PER_LOT=2
COINS_PHOTO_WIDTH=450
COINS_PHOTO_QUALITY=75
# ay.by: таймаут загрузки страницы и число подряд таймаутов/403/429, после которого цикл прерывается
COINS_NAV_TIMEOUT_MS=30000
COINS_MAX_STRIKES=3
# Numista (необязательно; бесплатный ключ: numista.com → API). Без ключа каталог только из load-catalog.js
NUMISTA_API_KEY=
