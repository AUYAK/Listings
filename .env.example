TELEGRAM_BOT_TOKEN=
# Default recipients, used by monitors that don't set their own chatIds in config.js
TELEGRAM_CHAT_IDS=
CHECK_INTERVAL_MS=300000

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false

# --- Монеты (coins.js, load-catalog.js) ---
# «Выгодно»: разница с ориентиром >= COINS_BARGAIN_BYN рублей, либо лот ниже ориентира на COINS_BARGAIN_PCT %
# и разница при этом >= COINS_BARGAIN_MIN_BYN рублей
COINS_BARGAIN_BYN=50
COINS_BARGAIN_PCT=30
COINS_BARGAIN_MIN_BYN=10
# Поправка к ценам внешних аукционов (gdenashel.ru, RUB → BYN) под наш рынок: 0.8 = считать, что у нас на 20% дешевле
COINS_CATALOG_FACTOR=1
# Окно проходов для каталога, лет (load-catalog.js)
COINS_CATALOG_YEARS=3
# За сколько минут до конца аукциона перечитывать ставку и сохранять фото (после окончания страница лота отдаёт 404)
COINS_PRECLOSE_MIN=40
# Фото лотов: папка, общий лимит в МБ (лишнее удаляется, проданные — последними), снимков на лот.
# Если установлен пакет sharp (npm i sharp), снимки сжимаются до COINS_PHOTO_WIDTH px / качество COINS_PHOTO_QUALITY
COINS_PHOTO_DIR=./coin-photos
COINS_PHOTO_MAX_MB=1024
COINS_PHOTO_PER_LOT=2
COINS_PHOTO_WIDTH=450
COINS_PHOTO_QUALITY=75
# ay.by: таймаут загрузки страницы и число подряд таймаутов/403/429, после которого цикл прерывается
COINS_NAV_TIMEOUT_MS=30000
COINS_MAX_STRIKES=3
# Numista (необязательно; бесплатный ключ: numista.com → API). Без ключа каталог только из load-catalog.js
NUMISTA_API_KEY=
# Цена металла (BYN за грамм) на случай, если API слитков НБРБ недоступен; обычно берётся с api.nbrb.by/ingots/prices
COINS_GOLD_BYN_PER_G=
COINS_SILVER_BYN_PER_G=
# ay.by: аккаунт для избранного и снайп-ставок. Проще всего войти руками: node ayby-login.js (окно браузера на сервере),
# cookies сохранятся в AYBY_SESSION_FILE (по умолчанию ./ayby-session.json), пароль в .env не нужен.
# AYBY_LOGIN/AYBY_PASSWORD — необязательный запасной вариант: автоматический вход, когда сессия протухла.
# Проверка: node debug-favorite.js <url лота>
AYBY_LOGIN=
AYBY_PASSWORD=
AYBY_SESSION_FILE=
# Снайп-ставки (sniper.js, pm2: coins-sniper): ответ на карточку лота числом = максимальная ставка.
# Ник на ay.by — чтобы бот узнавал вас в «победитель …» после торгов; ayby-login.js сам записывает его в файл сессии,
# задавать нужно только если там пусто. Чаты, которым разрешено ставить (по умолчанию TELEGRAM_CHAT_IDS).
# За сколько секунд до конца подтверждать ставку. AYBY_CDP=9222 — только для локальной отладки: работать через
# обычный Chrome, запущенный с --remote-debugging-port (он проходит проверку ay.by на бота, headless с ноутбука — нет).
AYBY_NICK=
SNIPE_CHAT_IDS=
SNIPE_SECONDS=30
AYBY_CDP=
